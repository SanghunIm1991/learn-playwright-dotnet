{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(cat)",
      "Bash(dotnet build)",
      "Bash(dotnet test)",
      "Bash(dotnet test tests/*)",
      "Bash(dotnet run --project src/LearnPlaywright.Server)",
      "PowerShell(dotnet build)",
      "PowerShell(dotnet test)",
      "PowerShell(dotnet run --project src/LearnPlaywright.Server)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git merge *)",
      "PowerShell(git merge *)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(git filter-branch *)",
      "PowerShell(git filter-branch *)",
      "Bash(git filter-repo *)",
      "PowerShell(git filter-repo *)",
      "Bash(git commit *--amend*)",
      "PowerShell(git commit *--amend*)",
      "Bash(git reset *--hard*)",
      "PowerShell(git reset *--hard*)",
      "Bash(git push *--force*)",
      "PowerShell(git push *--force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push * -f*)",
      "Bash(git push *--delete*)",
      "PowerShell(git push *--delete*)",
      "Bash(git branch *-D*)",
      "PowerShell(git branch *-D*)",
      "Bash(git clean *-f*)",
      "PowerShell(git clean *-f*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
